# CMD ALL-IN-ONE - modelo de configuracao.
#
# Copie para .env e preencha. No executavel, o proprio programa faz essa copia na primeira
# execucao, em %LOCALAPPDATA%\CMD-ALL-IN-ONE\.env. O .env nunca vai para o git.
#
# Regras:
# - o valor vem logo depois do "=", sem aspas; se tiver # ou *, use aspas simples
#   (exemplo: EMAIL_APP_PASSWORD='a#b*c');
# - NUNCA escreva comentario na mesma linha de uma variavel: ele vira parte do valor;
# - variavel obrigatoria em branco faz o programa abrir com a lista do que falta;
# - variavel com padrao pode ficar em branco: o programa usa o padrao indicado aqui.

# --- Identidade do tecnico ---

# OBRIGATORIO. Seu nome exatamente como aparece no ChatPanel e no Milldesk.
TECH_NAME=

# --- E-mail (IMAP, somente leitura) ---

# OBRIGATORIO. Endereco do servidor IMAP do provedor.
EMAIL_IMAP_HOST=
# Porta do IMAP. Padrao: 143 (STARTTLS). Use 993 para SSL direto.
EMAIL_IMAP_PORT=
# Usar STARTTLS? true ou false. Padrao: true. Com a porta 993, use false.
EMAIL_IMAP_STARTTLS=
# OBRIGATORIO. Caixa que sera lida (o endereco de e-mail completo, na maioria dos provedores).
EMAIL_USER=
# Senha ou senha de aplicativo da caixa. Em branco: o painel mostra "nao configurado".
EMAIL_APP_PASSWORD=
# Pasta da caixa de entrada. Padrao: INBOX.
EMAIL_INBOX_FOLDER=
# Pasta de spam, se o provedor tiver uma. Em branco: o contador de spam fica desligado.
EMAIL_SPAM_FOLDER=
# De quantos em quantos segundos reler a caixa. Padrao: 30. Minimo: 5.
EMAIL_REFRESH_SECONDS=
# Quantos e-mails recentes listar (so os cabecalhos). Padrao: 20. De 1 a 200.
EMAIL_LIST_SIZE=

# --- Milldesk ---

# Chave da API do Milldesk. Em branco: o painel mostra "nao configurado".
MILLDESK_API_KEY=
# Endereco base da API. Padrao: https://v1.milldesk.com/api
MILLDESK_BASE_URL=
# De quantos em quantos segundos reler os chamados. Padrao: 60. Minimo: 5.
MILLDESK_REFRESH_SECONDS=
# Seu nome no Milldesk, se for diferente do TECH_NAME. Em branco: usa o TECH_NAME.
MILLDESK_AGENT_NAME=
# Por quantos segundos guardar o detalhe de um chamado ja aberto. Padrao: 300.
MILLDESK_DETAIL_TTL_SECONDS=

# --- ChatPanel (WhatsApp) ---

# OBRIGATORIO. Endereco do chat.php do painel.
CHATPANEL_URL=
# Pasta do perfil do navegador (guarda a sessao). Padrao: .chatpanel-profile, dentro da
# pasta de dados do programa.
CHATPANEL_PROFILE_DIR=
# De quantos em quantos segundos reler as conversas. Padrao: 15. Minimo: 5.
CHATPANEL_REFRESH_SECONDS=
# Abrir o navegador sem janela? true ou false. Padrao: true.
CHATPANEL_HEADLESS=
# Usuario DEDICADO a TUI (nao o do tecnico); so pre-preenche a tela de login.
CHATPANEL_USER=
# Senha desse usuario. O captcha continua sendo resolvido por voce.
CHATPANEL_PASSWORD=
# Abrir a janela de login sozinho (1x por execucao) quando a sessao expirar? Padrao: true.
CHATPANEL_LOGIN_ON_START=
# De quantos em quantos segundos recarregar as listas (reflete transferencias).
# Padrao: 60. Use 0 para desligar; exige o usuario dedicado.
CHATPANEL_RESYNC_SECONDS=
# Enter na conversa carrega as mensagens? true ou false. Padrao: true (nao marca como lida).
CHATPANEL_READ_CONVERSATIONS=

# --- Enderecos abertos no navegador (tecla o e launcher) ---

# Webmail. Em branco: a tecla o avisa "nao configurado".
WEBMAIL_URL=
# Milldesk na web (nao existe endereco por chamado).
MILLDESK_WEB_URL=
# ChatPanel na web. Em branco: usa o mesmo endereco do CHATPANEL_URL.
CHATPANEL_WEB_URL=
# Mecanismo de busca do launcher, com {q} no lugar do termo.
# Padrao: https://www.google.com/search?q={q}
SEARCH_ENGINE_URL=

# --- Comportamento ---

# Bell do terminal quando um contador aumenta? true ou false. Padrao: true.
NOTIFY_BELL=
# Notificacao do Windows? true ou false. Padrao: false. Requer: pip install winotify
NOTIFY_TOAST=
# Detalhe do log em logs/app.log: DEBUG, INFO, WARNING ou ERROR. Padrao: INFO.
LOG_LEVEL=
# Tema inicial: carbon, phosphor, amber, paper, terminal, nord, gruvbox... Padrao: carbon.
# A tecla T troca e a escolha fica guardada em prefs.json, que tem prioridade sobre isto.
THEME=
# Icones: auto, unicode, nerd (exige Nerd Font no terminal) ou ascii. Padrao: auto.
ICONS=
# SLA abaixo de 30 min pisca? true ou false. Padrao: true.
SLA_BLINK=
# Ao abrir, verificar se ha versao nova? true ou false. Padrao: true.
UPDATE_CHECK=
