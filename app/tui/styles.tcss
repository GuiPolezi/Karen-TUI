/* CMD ALL-IN-ONE — folha de estilo.
 *
 * Só tokens: $bg $surface $surface-raised $border $text $text-muted $text-faint
 *            $accent $accent-soft $ok $warn $danger $mine $other
 * (ver app/tui/tokens.py e app/tui/themes.py). Nenhuma cor literal aqui — o teste
 * tests/test_design.py garante isso. Espaçamento: 0, 1 ou 2 células.
 */

Screen {
    layout: vertical;
    background: $bg;
    color: $text;
}

/* Barras ------------------------------------------------------------------- */

#topbar {
    height: 1;
    background: $surface;
    padding: 0 1;
}

#topbar-title {
    width: 1fr;
}

#topbar-health {
    width: auto;
    height: 1;
}

#topbar-health .topbar-dot {
    width: 2;
    text-align: center;
}

#topbar-status {
    width: 1fr;
    text-align: right;
}

#footer {
    dock: bottom;
    height: 1;
    background: $surface;
}

/* Widgets nativos que aparecem por cima --------------------------------------- */

Tooltip {
    background: $surface-raised;
    color: $text;
    border: round $border;
    padding: 0 1;
}

Toast {
    background: $surface-raised;
    color: $text;
    padding: 0 1;
    width: auto;
    min-width: 24;
    max-width: 60;
}

Toast.-information { border-left: outer $ok; }
Toast.-warning { border-left: outer $warn; }
Toast.-error { border-left: outer $danger; }
Toast .toast--title { color: $text-muted; text-style: none; }

/* Corpo do Dashboard ----------------------------------------------------------- */

#main {
    height: 1fr;
    padding: 0 1;
}

#top-row {
    height: 13;
}

#top-row > BasePanel {
    width: 1fr;
    height: 100%;
}

#chatpanel {
    height: 1fr;
}

/* Terminal estreito (< 100 colunas): empilha os painéis de cima */
#main.narrow #top-row {
    layout: vertical;
    height: auto;
}

#main.narrow #top-row > BasePanel {
    width: 1fr;
    height: 13;
}

/* Telas cheias: um painel ocupa tudo */
#email-full, #milldesk-full, #chatpanel-full {
    height: 1fr;
    margin: 0 1;
}

/* Painéis ---------------------------------------------------------------------- */

BasePanel {
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-faint;
    padding: 0 1;
    height: auto;
    min-height: 7;
}

BasePanel:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

BasePanel.error {
    border: round $danger;
}

BasePanel.unconfigured {
    border: round $border;
    border-title-color: $text-muted;
}

BasePanel .panel-head {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

BasePanel .panel-filter {
    height: 1;
    border: none;
    padding: 0;
    background: $surface;
}

BasePanel .panel-table {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
}

BasePanel .panel-error {
    color: $danger;
    height: auto;
    display: none;
}

/* Log (F5) ------------------------------------------------------------------- */

#log-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#log-lines {
    height: 1fr;
    margin: 0 1;
    border: round $border;
    scrollbar-size: 1 1;
}

/* Notas (F6) ----------------------------------------------------------------- */

#notes-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#notes-text {
    height: 1fr;
    margin: 0 1;
}

/* Launcher (:) e ajuda (?) ----------------------------------------------------- */

LauncherScreen {
    align: center top;
    background: $bg 40%;
}

#launcher {
    width: 80%;
    height: auto;
    margin-top: 2;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#launcher-input {
    border: none;
    padding: 0;
    background: $surface;
}

#launcher-hint {
    height: auto;
    padding: 0 1;
}

HelpScreen {
    align: center middle;
    background: $bg 60%;
}

#help {
    width: 90%;
    height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#help-columns {
    height: auto;
}

#help-keys, #help-commands {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#help-footer {
    height: auto;
}

/* Eventos (F7) e Saúde (F8) --------------------------------------------------- */

#events-status, #health-sources, #health-extra {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#events-table {
    height: 1fr;
    margin: 0 1;
    scrollbar-size: 1 1;
}

#health {
    height: 1fr;
    margin: 0 1;
}

#health-sources {
    color: $text;
    margin-bottom: 1;
}

#health-extra {
    color: $text;
}

/* Modais de detalhe (e-mail, chamado, conversa) --------------------------------- */

ConversationDetailScreen, TicketDetailScreen, EmailDetailScreen {
    align: center middle;
    background: $bg 60%;
}

#conversation, #ticket-detail, #email-detail {
    width: 92%;
    height: 92%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#conversation-header, #ticket-header, #email-detail-header {
    height: auto;
    margin-bottom: 1;
    border-bottom: solid $border;
}

#conversation-messages, #email-detail-body {
    height: auto;
}

#ticket-sla, #ticket-body, #ticket-resolution, #ticket-communications {
    height: auto;
    margin-bottom: 1;
}

#conversation-footer, #ticket-footer, #email-detail-footer {
    height: auto;
    margin-top: 1;
}
