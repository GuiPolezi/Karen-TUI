# --- Identidade do técnico ---
TECH_NAME=Guilherme                      # exatamente como aparece no ChatPanel e no Milldesk

# --- E-mail (IMAP) ---
EMAIL_IMAP_HOST=imap.sinoinformatica.com.br
EMAIL_IMAP_PORT=143                      # 143 = STARTTLS; 993 = SSL direto
EMAIL_IMAP_STARTTLS=true
EMAIL_USER=suporte@sinoinformatica.com.br
EMAIL_APP_PASSWORD=                      # preencher; se tiver "#" ou "*", manter entre aspas simples
EMAIL_INBOX_FOLDER=INBOX
EMAIL_SPAM_FOLDER=Junk E-Mail
EMAIL_REFRESH_SECONDS=30
EMAIL_LIST_SIZE=20                       # e-mails recentes listados (só cabeçalhos)

# --- Milldesk ---
MILLDESK_API_KEY=
MILLDESK_BASE_URL=https://v1.milldesk.com/api
MILLDESK_REFRESH_SECONDS=60
MILLDESK_AGENT_NAME=                   # nome no Milldesk se for diferente de TECH_NAME (ex.: Guilherme P.)
MILLDESK_DETAIL_TTL_SECONDS=300        # cache do detalhe de um chamado (Enter na lista)

# --- ChatPanel ---
CHATPANEL_URL=https://srv02.chatpanel.space/8b1847a98299/chat.php
CHATPANEL_PROFILE_DIR=.chatpanel-profile # perfil persistente do Chromium (gitignored)
CHATPANEL_REFRESH_SECONDS=15
CHATPANEL_HEADLESS=true
CHATPANEL_USER=                          # usuário DEDICADO à TUI (não o do técnico); pré-preenche o login
CHATPANEL_PASSWORD=                      # senha dele (o captcha continua manual)
CHATPANEL_LOGIN_ON_START=true            # abre a janela de login sozinho (1x por execução) se a sessão expirou
CHATPANEL_RESYNC_SECONDS=60              # recarrega as listas a cada N s (reflete transferências); 0 desliga
CHATPANEL_READ_CONVERSATIONS=true        # Enter na conversa carrega as mensagens (medido: não marca como lida)

# --- Navegador (tecla o e launcher) ---
WEBMAIL_URL=                             # ex.: https://webmail.exemplo.com.br/
MILLDESK_WEB_URL=                        # ex.: https://conta.milldesk.com/ (não há URL por chamado)
CHATPANEL_WEB_URL=                       # vazio = mesma CHATPANEL_URL
SEARCH_ENGINE_URL=https://www.google.com/search?q={q}

# --- Geral ---
NOTIFY_BELL=true                         # bell do terminal quando um contador aumenta
NOTIFY_TOAST=false                       # notificação do Windows (requer: pip install winotify)
LOG_LEVEL=INFO

# --- Aparência ---
THEME=carbon                             # carbon | phosphor | amber | paper | terminal | nord | gruvbox | ... (T cicla; prefs.json guarda a escolha)
ICONS=auto                               # auto | unicode | nerd (requer Nerd Font no terminal) | ascii
SLA_BLINK=true                           # SLA abaixo de 30 min pisca
UPDATE_CHECK=true                        # ao abrir, git fetch e aviso "atualização disponível" (quem atualiza é o iniciar.cmd)
