/* CMD ALL-IN-ONE — folha de estilo.
 *
 * Só tokens: $bg $surface $surface-raised $border $text $text-muted $text-faint
 *            $accent $accent-soft $ok $warn $danger $mine $other
 * (ver app/tui/tokens.py e app/tui/themes.py). Nenhuma cor literal aqui — o teste
 * tests/test_design.py garante isso. Espaçamento: 0, 1 ou 2 células.
 */

Screen {
    layout: vertical;
    background: $bg;
    color: $text;
}

/* Barras ------------------------------------------------------------------- */

#topbar {
    height: 1;
    background: $surface;
    padding: 0 1;
}

#topbar-title {
    width: 1fr;
}

#topbar-health {
    width: auto;
    height: 1;
}

#topbar-health .topbar-dot {
    width: 2;
    text-align: center;
}

#topbar-status {
    width: 1fr;
    text-align: right;
}

#footer {
    dock: bottom;
    height: 1;
    background: $surface;
}

/* Widgets nativos que aparecem por cima --------------------------------------- */

Tooltip {
    background: $surface-raised;
    color: $text;
    border: round $border;
    padding: 0 1;
}

Toast {
    background: $surface-raised;
    color: $text;
    padding: 0 1;
    width: auto;
    min-width: 24;
    max-width: 60;
}

Toast.-information { border-left: outer $ok; }
Toast.-warning { border-left: outer $warn; }
Toast.-error { border-left: outer $danger; }
Toast .toast--title { color: $text-muted; text-style: none; }

/* Corpo do Dashboard ----------------------------------------------------------- */

#main {
    height: 1fr;
    padding: 0 1;
}

/* a linha de cima e o ChatPanel dividem a altura 3:2; em terminal baixo a de cima é fixa */
#top-row {
    height: 3fr;
    margin-top: 1;
}

DashboardScreen.-short #top-row {
    height: 8;
    margin-top: 0;
}

#top-row > BasePanel {
    width: 1fr;
    height: 100%;
}

#top-rule {
    width: 3;
    height: 100%;
    margin: 0;
    color: $border;
}

#chatpanel {
    height: 2fr;
    margin-top: 1;
}

/* Terminal estreito (< 100 colunas): empilha os painéis de cima */
DashboardScreen.-narrow #top-row {
    layout: vertical;
    height: auto;
    margin-top: 0;
}

DashboardScreen.-narrow #top-row > BasePanel {
    width: 1fr;
    height: 11;
}

DashboardScreen.-narrow #top-rule {
    display: none;
}

/* Terminal baixo: só contadores e SLA nos painéis de cima */
DashboardScreen.-short #email .panel-extra,
DashboardScreen.-short #top-row .panel-table,
DashboardScreen.-short #top-row .panel-foot {
    display: none;
}

/* Telas cheias: um painel ocupa tudo */
#email-full, #milldesk-full, #chatpanel-full {
    height: 1fr;
    margin: 1 1 0 1;
}

/* Painéis (sem borda; o foco é o título em accent + marcador) ------------------- */

BasePanel {
    padding: 0 1;
    height: auto;
    min-height: 5;
}

BasePanel .panel-title {
    height: 1;
}

BasePanel .panel-name {
    width: 1fr;
}

BasePanel .panel-meta {
    width: auto;
    min-width: 12;
    text-align: right;
}

BasePanel .panel-digits {
    height: 4;
    margin-top: 1;
}

BasePanel .digit-block {
    width: auto;
    height: 4;
    margin-right: 4;
}

BasePanel .digit-block .digit-value {
    width: auto;
    color: $text;
}

BasePanel .digit-block.-accent .digit-value { color: $accent; }
BasePanel .digit-block.-danger .digit-value { color: $danger; }
BasePanel .digit-block.-faint .digit-value { color: $text-faint; }

BasePanel .digit-block .digit-label {
    width: 100%;
    text-align: center;
    color: $text-muted;
}

BasePanel .panel-summary {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

BasePanel .panel-extra {
    height: auto;
    margin-top: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

BasePanel .panel-filter {
    height: 1;
    border: none;
    padding: 0;
    margin-top: 1;
    background: $surface;
}

BasePanel .panel-table {
    height: 1fr;
    min-height: 2;
    margin-top: 1;
    scrollbar-size: 1 1;
}

BasePanel .panel-table > .datatable--header {
    color: $text-faint;
    background: $bg;
    text-style: none;
}

BasePanel .panel-foot {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Log (F5) ------------------------------------------------------------------- */

#log-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#log-lines {
    height: 1fr;
    margin: 0 1;
    border: round $border;
    scrollbar-size: 1 1;
}

/* Notas (F6) ----------------------------------------------------------------- */

#notes-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#notes-text {
    height: 1fr;
    margin: 0 1;
}

/* Launcher (:) e ajuda (?) ----------------------------------------------------- */

LauncherScreen {
    align: center top;
    background: $bg 40%;
}

#launcher {
    width: 80%;
    height: auto;
    margin-top: 2;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#launcher-input {
    border: none;
    padding: 0;
    background: $surface;
}

#launcher-hint {
    height: auto;
    padding: 0 1;
}

HelpScreen {
    align: center middle;
    background: $bg 60%;
}

#help {
    width: 90%;
    height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#help-columns {
    height: auto;
}

#help-keys, #help-commands {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#help-footer {
    height: auto;
}

/* Eventos (F7) e Saúde (F8) --------------------------------------------------- */

#events-status, #health-sources, #health-extra {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#events-table {
    height: 1fr;
    margin: 0 1;
    scrollbar-size: 1 1;
}

#health {
    height: 1fr;
    margin: 0 1;
}

#health-sources {
    color: $text;
    margin-bottom: 1;
}

#health-extra {
    color: $text;
}

/* Modais de detalhe (e-mail, chamado, conversa) --------------------------------- */

ConversationDetailScreen, TicketDetailScreen, EmailDetailScreen {
    align: center middle;
    background: $bg 60%;
}

#conversation, #ticket-detail, #email-detail {
    width: 92%;
    height: 92%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#conversation-header, #ticket-header, #email-detail-header {
    height: auto;
    margin-bottom: 1;
    border-bottom: solid $border;
}

#conversation-messages, #email-detail-body {
    height: auto;
}

#ticket-sla, #ticket-body, #ticket-resolution, #ticket-communications {
    height: auto;
    margin-bottom: 1;
}

#conversation-footer, #ticket-footer, #email-detail-footer {
    height: auto;
    margin-top: 1;
}
