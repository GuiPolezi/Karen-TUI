/* CMD ALL-IN-ONE — folha de estilo.
 *
 * Só tokens: $bg $surface $surface-raised $border $text $text-muted $text-faint
 *            $accent $accent-soft $ok $warn $danger $mine $other
 * (ver app/tui/tokens.py e app/tui/themes.py). Nenhuma cor literal aqui — o teste
 * tests/test_design.py garante isso. Espaçamento: 0, 1 ou 2 células.
 */

Screen {
    layout: vertical;
    background: $bg;
    color: $text;
}

/* Barras ------------------------------------------------------------------- */

#topbar {
    height: 1;
    background: $surface;
    padding: 0 1;
}

#topbar-title {
    width: 1fr;
}

#topbar-health {
    width: auto;
    height: 1;
}

#topbar-health .topbar-dot {
    width: 2;
    text-align: center;
}

#topbar-status {
    width: 1fr;
    text-align: right;
}

#footer {
    dock: bottom;
    height: 1;
    background: $surface;
}

/* Widgets nativos que aparecem por cima --------------------------------------- */

Tooltip {
    background: $surface-raised;
    color: $text;
    border: round $border;
    padding: 0 1;
}

Toast {
    background: $surface-raised;
    color: $text;
    padding: 0 1;
    width: auto;
    min-width: 24;
    max-width: 60;
}

Toast.-information { border-left: outer $ok; }
Toast.-warning { border-left: outer $warn; }
Toast.-error { border-left: outer $danger; }
Toast .toast--title { color: $text-muted; text-style: none; }

/* Corpo do Dashboard ----------------------------------------------------------- */

#main {
    height: 1fr;
    padding: 0 1;
}

/* a linha de cima e o ChatPanel dividem a altura 3:2; em terminal baixo a de cima é fixa */
#top-row {
    height: 3fr;
    margin-top: 1;
}

DashboardScreen.-short #top-row {
    height: 8;
    margin-top: 0;
}

#top-row > BasePanel {
    width: 1fr;
    height: 100%;
}

#top-rule {
    width: 3;
    height: 100%;
    margin: 0;
    color: $border;
}

#chatpanel {
    height: 2fr;
    margin-top: 1;
}

/* Terminal estreito (< 100 colunas): empilha os painéis de cima */
DashboardScreen.-narrow #top-row {
    layout: vertical;
    height: auto;
    margin-top: 0;
}

DashboardScreen.-narrow #top-row > BasePanel {
    width: 1fr;
    height: 11;
}

DashboardScreen.-narrow #top-rule {
    display: none;
}

/* Terminal baixo: só contadores e SLA nos painéis de cima */
DashboardScreen.-short #email .panel-extra,
DashboardScreen.-short #top-row .panel-table,
DashboardScreen.-short #top-row .panel-foot {
    display: none;
}

/* Telas cheias: um painel ocupa tudo */
#email-full, #milldesk-full, #chatpanel-full {
    height: 1fr;
    margin: 1 1 0 1;
}

/* Painéis (sem borda; o foco é o título em accent + marcador) ------------------- */

BasePanel {
    padding: 0 1;
    height: auto;
    min-height: 5;
}

BasePanel .panel-title {
    height: 1;
}

BasePanel .panel-name {
    width: 1fr;
}

BasePanel .panel-meta {
    width: auto;
    min-width: 12;
    text-align: right;
}

BasePanel .panel-digits {
    height: 4;
    margin-top: 1;
}

BasePanel .digit-block {
    width: auto;
    height: 4;
    margin-right: 4;
}

BasePanel .digit-block .digit-value {
    width: auto;
    color: $text;
}

BasePanel .digit-block.-accent .digit-value { color: $accent; }
BasePanel .digit-block.-danger .digit-value { color: $danger; }
BasePanel .digit-block.-faint .digit-value { color: $text-faint; }

BasePanel .digit-block .digit-label {
    width: 100%;
    text-align: center;
    color: $text-muted;
}

BasePanel .panel-summary {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

BasePanel .panel-extra {
    height: auto;
    margin-top: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

BasePanel .panel-filter-row {
    height: 1;
    margin-top: 1;
}

BasePanel .panel-filter-icon {
    width: 2;
}

BasePanel .panel-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $surface;
}

BasePanel .panel-table {
    height: 1fr;
    min-height: 2;
    margin-top: 1;
    scrollbar-size: 1 1;
}

/* erro sem dados, não configurado, vazio, filtro sem resultado: no lugar da lista */
BasePanel .panel-placeholder {
    height: 1fr;
    min-height: 3;
    margin-top: 1;
    content-align: center middle;
    text-align: center;
    display: none;
}

BasePanel .panel-table > .datatable--header {
    color: $text-faint;
    background: $bg;
    text-style: none;
}

BasePanel .panel-foot {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Log (F5) ------------------------------------------------------------------- */

#log-status {
    height: 1;
    margin: 1 2 0 2;
}

#log-lines {
    height: 1fr;
    margin: 1 2 0 2;
    background: $bg;
    scrollbar-size: 1 1;
}

/* Notas (F6) ----------------------------------------------------------------- */

#notes-status {
    height: 1;
    margin: 1 2 0 2;
}

#notes-text {
    height: 1fr;
    margin: 1 1 0 1;
    border: none;
    padding: 0 1;
    background: $bg;
}

#notes-text:focus {
    border: none;
}

/* Launcher (:) — uma linha na base, acima do rodapé --------------------------------- */

LauncherScreen {
    align: left bottom;
    background: $bg 40%;
}

#launcher {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    background: $surface;
    padding: 0 1;
}

#launcher-hint, #launcher-suggestions {
    height: auto;
    padding: 0 2;
}

#launcher-line {
    height: 1;
}

#launcher-prompt {
    width: 2;
}

#launcher-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $surface;
}

/* Ajuda (?) ------------------------------------------------------------------- */

HelpScreen {
    align: center middle;
    background: $bg 85%;
}

#help {
    width: 100;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#help-columns {
    height: auto;
}

#help-keys, #help-commands {
    width: 1fr;
    height: auto;
}

.help-group {
    height: auto;
    margin-bottom: 1;
}

#help-footer {
    height: auto;
}

/* Eventos (F7) --------------------------------------------------------------- */

#events-status {
    height: auto;
    margin: 1 2 0 2;
}

#events-table {
    height: 1fr;
    margin: 1 1 0 1;
    scrollbar-size: 1 1;
}

/* Saúde (F8) ----------------------------------------------------------------- */

#health {
    height: 1fr;
    margin: 1 2 0 2;
}

#health-title, #health-columns {
    height: 1;
}

#health-sources {
    height: auto;
    margin-bottom: 1;
}

.health-row {
    height: 1;
}

.health-dot { width: 3; text-align: center; }
.health-name { width: 13; }
.health-status { width: 18; }
.health-last { width: 13; }
.health-duration { width: 11; }
.health-next { width: 11; }
.health-spark { width: 24; height: 1; margin-right: 2; }
.health-spark > .sparkline--max-color { color: $accent; }
.health-spark > .sparkline--min-color { color: $accent 30%; }
.health-detail { width: 1fr; }

#health-extra {
    height: auto;
}

/* Temas (F9) ----------------------------------------------------------------- */

#themes {
    height: 1fr;
    margin: 1 1 0 1;
}

#themes-left {
    width: 30;
    height: 1fr;
    margin-right: 1;
}

#themes-title {
    height: 1;
    margin-bottom: 1;
    padding: 0 1;
}

#themes-list {
    height: 1fr;
    border: none;
    background: $bg;
    padding: 0;
}

#themes-list:focus {
    border: none;
    background: $bg;
}

#themes-middle {
    width: 46;
    height: 1fr;
    margin-right: 1;
    padding: 0 1;
    border-left: solid $border;
}

#themes-right {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border-left: solid $border;
}

#themes-tokens, #themes-sample {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Modais de detalhe (e-mail, chamado, conversa) --------------------------------- */

DetailScreen {
    align: center middle;
    background: $bg 90%;
}

#detail {
    width: 100;
    max-width: 96%;
    height: 92%;
    border: round $accent;
    background: $surface;
    padding: 0 2;
}

.detail-header {
    height: auto;
    padding: 0;
    border-bottom: solid $border;
}

.detail-body {
    height: 1fr;
    padding: 1 2 0 2;
    scrollbar-size: 1 1;
}

.detail-loading {
    height: 3;
    display: none;
}

.detail-text, #ticket-fields, #ticket-sla, #ticket-body, #ticket-resolution, #ticket-communications,
#conversation-notice {
    height: auto;
    margin-bottom: 1;
}

#conversation-messages {
    height: auto;
}

.message-row {
    height: auto;
    margin-bottom: 1;
}

.message-row .message {
    width: 80%;
    height: auto;
}

.message-row.-mine {
    align-horizontal: right;
}

.message-row.-mine .message {
    text-align: right;
}

.message-row.-system {
    align-horizontal: center;
}

.message-row.-system .message {
    width: auto;
    text-align: center;
}
