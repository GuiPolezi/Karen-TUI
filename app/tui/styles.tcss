/* Layout geral ------------------------------------------------------------ */

Screen {
    layout: vertical;
}

#header {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#header #title {
    width: 1fr;
    text-style: bold;
}

#header #clock {
    width: auto;
}

#main {
    height: 1fr;
    padding: 0 1;
}

#top-row {
    height: 13;
}

#top-row > BasePanel {
    width: 1fr;
    height: 100%;
}

#chatpanel {
    height: 1fr;
}

/* Terminal estreito (< 100 colunas): empilha os painéis de cima */
#main.narrow #top-row {
    layout: vertical;
    height: auto;
}

#main.narrow #top-row > BasePanel {
    width: 1fr;
    height: 13;
}

/* Telas cheias: um painel ocupa tudo */
#email-full, #milldesk-full, #chatpanel-full {
    height: 1fr;
    margin: 0 1;
}

/* Painéis ----------------------------------------------------------------- */

BasePanel {
    border: round $primary;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    height: auto;
    min-height: 7;
}

BasePanel:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

BasePanel.error {
    border: round $error;
    border-title-color: $error;
}

BasePanel.unconfigured {
    border: round $warning;
}

BasePanel.changed {
    border: heavy $warning;
    border-title-color: $warning;
}

BasePanel .panel-head {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

BasePanel .panel-filter {
    height: 1;
    border: none;
    padding: 0;
    background: $surface;
}

BasePanel .panel-table {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
}

BasePanel .panel-table > .datatable--cursor {
    background: $accent 30%;
}

BasePanel .panel-error {
    color: $error;
    height: auto;
    display: none;
}

/* Log (F5) ---------------------------------------------------------------- */

#log-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#log-lines {
    height: 1fr;
    margin: 0 1;
    border: round $secondary;
    scrollbar-size: 1 1;
}

/* Notas (F6) -------------------------------------------------------------- */

#notes-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#notes-text {
    height: 1fr;
    margin: 0 1;
}

/* Launcher (:) e ajuda (?) ------------------------------------------------- */

LauncherScreen {
    align: center top;
    background: $background 40%;
}

#launcher {
    width: 80%;
    height: auto;
    margin-top: 2;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#launcher-input {
    border: none;
    padding: 0;
    background: $surface;
}

#launcher-hint {
    height: auto;
    padding: 0 1;
}

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help {
    width: 90%;
    height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#help-keys, #help-commands, #help-footer {
    height: auto;
    margin-bottom: 1;
}

/* Eventos (F7) e Saúde (F8) ----------------------------------------------- */

#events-status, #health-sources, #health-extra {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#events-table {
    height: 1fr;
    margin: 0 1;
    scrollbar-size: 1 1;
}

#health {
    height: 1fr;
    margin: 0 1;
}

#health-sources {
    color: $text;
    margin-bottom: 1;
}

#health-extra {
    color: $text;
}

/* Detalhe do chamado (Enter no Milldesk) ----------------------------------- */

TicketDetailScreen {
    align: center middle;
    background: $background 60%;
}

#ticket-detail {
    width: 92%;
    height: 92%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#ticket-header {
    height: auto;
    margin-bottom: 1;
    border-bottom: solid $secondary;
}

#ticket-sla {
    height: auto;
    margin-bottom: 1;
}

#ticket-body, #ticket-resolution, #ticket-communications {
    height: auto;
    margin-bottom: 1;
}

#ticket-footer {
    height: auto;
    margin-top: 1;
}

/* Detalhe do e-mail (e / Enter) ------------------------------------------- */

EmailDetailScreen {
    align: center middle;
    background: $background 60%;
}

#email-detail {
    width: 90%;
    height: 90%;
    border: round $primary;
    border-title-color: $text;
    background: $surface;
    padding: 1 2;
}

#email-detail-header {
    height: auto;
    margin-bottom: 1;
    border-bottom: solid $secondary;
}

#email-detail-body {
    height: auto;
}

#email-detail-footer {
    height: auto;
    margin-top: 1;
}
